# Dependencies
node_modules/

# Environment Variables (sensitive)
.env
.env.local
.env.*.local

# Vercel build output
.vercel/

# Runtime data & uploads (preserves folder structure via .gitkeep)
data/photos/*
!data/photos/.gitkeep
data/history/*
!data/history/.gitkeep
data/inventories/*
!data/inventories/.gitkeep
data/justifications/*
!data/justifications/.gitkeep
data/audit/*
!data/audit/.gitkeep
data/fotosreferencias/*
!data/fotosreferencias/.gitkeep

# Temporary and generated files
scratch/
nibol/

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
